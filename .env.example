# 1) ใช้กับ drizzle-kit (npm run db:migrate): ฐานข้อมูลที่จะสร้างตาราง
#    ใช้ฐานข้อมูลออนไลน์ (Neon) ได้เลย ไม่ต้องติดตั้ง Docker
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# 2) ใช้โดย wrangler dev เท่านั้น: ฐานข้อมูลที่ Hyperdrive จะต่อให้ตอนรันในเครื่อง (ใส่ค่าเดียวกับข้อ 1 ได้)
#    หมายเหตุ: wrangler บังคับให้ connection string ต้องมีรหัสผ่านเสมอ
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://user:password@host/dbname?sslmode=require
